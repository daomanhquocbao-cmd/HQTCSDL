.gitignore# Environment & Secret files
.env
.env.local
*.pem
*.key

# Dependencies
node_modules/
venv/
.venv/
vendor/

# Build & Output
dist/
build/
target/
bin/
obj/
*.exe
*.jar

# Logs & Database local
*.log
logs/
*.sqlite
*.db

# User Uploaded files (tránh commit file rác sinh ra trong lúc test)
uploads/*
!uploads/.gitkeep

# Operating System & IDEs
.DS_Store
.vscode/
.idea/

# Dev-only / sinh ra khi chạy thử
database/11_dev_passwords.sql
database/12_dev_passwords_by_prefix.sql
__pycache__/
*.pyc
.pytest_cache/
.dart_tool/
mobile/build/
mobile/.flutter-plugins*
